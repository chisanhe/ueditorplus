{
    "name": "chisanhe/ueditorplus",
    "description": "Dcat Admin UeditorPlus 富文本编辑器扩展，基于 ueditorplus 开发",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "dcat-admin",
        "ueditor",
        "ueditorplus",
        "富文本编辑器"
    ],
    "require": {
        "php": ">=8.1 <8.5",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "printnow/laravel-admin": "^2.4"
    },
    "replace": {
        "dcat/laravel-admin": "2.2.99"
    },
    "suggest": {
        "dcat/laravel-admin": "Laravel 9 及以下版本请继续使用官方 dcat/laravel-admin（需将根项目 minimum-stability 设为 dev）"
    },
    "autoload": {
        "psr-4": {
            "Chisanhe\\Ueditorplus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chisanhe\\Ueditorplus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chisanhe\\Ueditorplus\\ChisanheUeditorplusServiceProvider"
            ]
        }
    }
}
